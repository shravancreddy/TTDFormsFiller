{
   "action": {
      "default_icon": {
         "128": "chrome_store_icon_128_clean.png",
         "16": "icon-16.png",
         "32": "icon-32.png",
         "48": "icon-48.png"
      },
      "default_popup": "src/popup/index.html"
   },
   "background": {
      "service_worker": "service-worker-loader.js",
      "type": "module"
   },
   "content_scripts": [ {
      "js": [ "assets/autofill.js-CMTxtjwz.js" ],
      "matches": [ "https://tirupatibalaji.ap.gov.in/*", "https://ttdevasthanams.ap.gov.in/*" ]
   } ],
   "default_locale": "en",
   "description": "Premium autofill assistant for TTD services.",
   "externally_connectable": {
      "matches": [ "https://ttd-info.vercel.app/*" ]
   },
   "icons": {
      "128": "chrome_store_icon_128_clean.png",
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "TTD Autofill Assistant",
   "options_ui": {
      "open_in_tab": true,
      "page": "src/options/index.html"
   },
   "permissions": [ "storage", "alarms", "activeTab" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "7.0.0",
   "web_accessible_resources": [ {
      "matches": [ "https://tirupatibalaji.ap.gov.in/*", "https://ttdevasthanams.ap.gov.in/*" ],
      "resources": [ "assets/autofill.js-CMTxtjwz.js" ],
      "use_dynamic_url": false
   } ]
}
